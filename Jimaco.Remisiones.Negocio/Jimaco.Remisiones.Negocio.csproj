<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Jimaco.Remisiones.Modelo\Jimaco.Remisiones.Modelo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo embebido en el ensamblado (no depende de que un archivo suelto se copie bien al
         contenedor) — lo carga CotizacionPdfBuilder vía Assembly.GetManifestResourceStream. -->
    <EmbeddedResource Include="Documentos\Assets\logo-jimaco.png" />
    <EmbeddedResource Include="Datos\municipios-dane.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
